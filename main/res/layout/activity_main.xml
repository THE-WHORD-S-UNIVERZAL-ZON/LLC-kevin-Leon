<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uz_background"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:fitsSystemWindows="true">

        <!-- Identidad de marca -->



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="18dp">

<ImageButton
                android:id="@+id/menu_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_open"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_menu_24"
                android:tooltipText="@string/menu_open" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardBackgroundColor="@color/uz_surface_elevated"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/uz_outline"
                app:strokeWidth="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="UZ"
                    android:textColor="@color/uz_silver_bright"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="UNIVERSAL-ZON AI"
                    android:textColor="@color/uz_white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.035"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="BY THE WHORD'S &amp; UNIVERSAL-ZON LLC"
                    android:textColor="@color/uz_silver_muted"
                    android:textSize="9sp"
                    android:letterSpacing="0.045"
                    android:maxLines="2" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@drawable/bg_assistant_message"
                android:text="AI"
                android:textColor="@color/uz_silver_bright"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            app:dividerColor="@color/uz_outline" />

        <!-- Encabezado de conversación -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TU ESPACIO DE IA"
            android:textColor="@color/uz_silver_bright"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="14dp"
            android:text="Una experiencia inteligente, a tu manera."
            android:textColor="@color/uz_text_secondary"
            android:textSize="13sp" />

        <!-- Estado e información del modelo actual -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="@color/uz_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/uz_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_assistant_message" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="MODELO DE IA"
                        android:textColor="@color/uz_silver"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GGUF"
                        android:textColor="@color/uz_silver_muted"
                        android:textSize="10sp"
                        android:letterSpacing="0.08" />
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxHeight="92dp"
                    android:fillViewport="false"
                    android:fadeScrollbars="false">

                    <TextView
                        android:id="@+id/gguf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Todavía no has seleccionado un modelo. Pulsa el botón de abajo para importar un archivo GGUF."
                        android:textColor="@color/uz_text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp"
                        tools:ignore="HardcodedText" />
                </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mensajes existentes: conserva el identificador usado por Kotlin -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:fadeScrollbars="false"
            android:scrollbars="vertical"
            app:reverseLayout="true"
            tools:listitem="@layout/item_message_assistant" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            app:dividerColor="@color/uz_outline" />

        <!-- Compositor: mantiene user_input y fab para el código actual -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="@color/uz_surface"
            app:cardCornerRadius="22dp"
            app:strokeColor="@color/uz_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <EditText
                    android:id="@+id/user_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:enabled="false"
                    android:hint="Selecciona primero un modelo GGUF…"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4"
                    android:minHeight="48dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/uz_white"
                    android:textColorHint="@color/uz_silver_muted"
                    android:textSize="14sp" />

                        <ImageButton
            android:id="@+id/btn_mic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Dictar por voz"
            android:src="@drawable/ic_mic_24"
            android:padding="10dp" />
<com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fab"
                    style="@style/Widget.Material3.FloatingActionButton.Primary"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Seleccionar modelo o enviar mensaje"
                    android:enabled="true"
                    android:src="@drawable/outline_folder_open_24"
                    app:backgroundTint="@color/uz_silver_bright"
                    app:tint="@color/uz_black"
                    app:elevation="0dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="4dp"
            android:text="UNIVERSAL-ZON AI  •  INTELIGENCIA A TU ALCANCE"
            android:textColor="@color/uz_silver_muted"
            android:textSize="9sp"
            android:letterSpacing="0.06" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_gravity="start"
    android:layout_height="match_parent"
    android:background="@color/uz_surface"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardBackgroundColor="@color/uz_surface_elevated"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/uz_outline"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="UZ"
                android:textColor="@color/uz_silver_bright"
                android:textSize="21sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/menu_title"
            android:textColor="@color/uz_white"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/menu_subtitle"
            android:textColor="@color/uz_text_secondary"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="22dp"
            android:background="@color/uz_outline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_section_workspace"
            android:textColor="@color/uz_silver_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_new_chat"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="@string/nav_new_chat"
            android:textColor="@color/uz_white"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_storage"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="start|center_vertical"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="@string/nav_storage"
            android:textColor="@color/uz_white"
            app:cornerRadius="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="20dp"
            android:background="@color/uz_outline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_section_preferences"
            android:textColor="@color/uz_silver_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_online_mode"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="@string/nav_online_mode"
            android:textColor="@color/uz_white"
            app:cornerRadius="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="20dp"
            android:background="@color/uz_outline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_section_information"
            android:textColor="@color/uz_silver_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nav_about"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="@string/nav_about"
            android:textColor="@color/uz_white"
            app:cornerRadius="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/brand_company"
            android:textColor="@color/uz_silver_muted"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
