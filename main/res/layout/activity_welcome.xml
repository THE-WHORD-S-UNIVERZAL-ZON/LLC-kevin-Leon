<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uz_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="88dp"
            android:layout_height="88dp"
            app:cardBackgroundColor="@color/uz_surface_elevated"
            app:cardCornerRadius="24dp"
            app:strokeColor="@color/uz_outline"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="UZ"
                android:textColor="@color/uz_silver_bright"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/uz_white"
            android:textSize="27sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/brand_company"
            android:textColor="@color/uz_silver"
            android:textSize="13sp"
            android:letterSpacing="0.025" />

        <View
            android:layout_width="56dp"
            android:layout_height="2dp"
            android:layout_marginTop="28dp"
            android:background="@color/uz_silver_muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="@string/welcome_headline"
            android:textColor="@color/uz_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:text="@string/welcome_description"
            android:textColor="@color/uz_text_secondary"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/welcome_continue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="36dp"
            android:text="@string/welcome_continue"
            android:textAllCaps="false"
            android:textColor="@color/uz_black"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/uz_silver_bright"
            app:cornerRadius="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/brand_tagline"
            android:textColor="@color/uz_silver_muted"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
